{
    "name": "modestox/config-processor",
    "description": "Configuration schema validation and processing library for PHP",
    "homepage": "https://github.com/Modestox/config-processor",
    "authors": [
        {
            "name": "Sergey Kuzmitsky",
            "email": "ubuntu.ksm@gmail.com",
            "homepage": "https://github.com/modestox"
        }
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Modestox\\ConfigProcessor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modestox\\ConfigProcessor\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
